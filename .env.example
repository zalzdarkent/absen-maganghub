# Bisa diisi manual di sini (GEMINI_API_KEY & GITHUB_TOKEN).
# Repo GitHub sekarang disimpan di settings.json via tab "Pengaturan" (bukan di .env lagi).
# Jika lewat dashboard, file .env akan dibuat/diupdate otomatis untuk key di bawah.

GEMINI_API_KEY=
GITHUB_TOKEN=
# Model terbaru & direkomendasikan: gemini-3.6-flash (paling stabil & cepat saat ini)
# Alternatif: gemini-2.5-flash / gemini-2.0-flash jika tersedia di akunmu
GEMINI_MODEL=gemini-3.6-flash

# --- Web Push (Opsi B: notifikasi walau tab ditutup) ---
# Generate sekali: npx web-push generate-vapid-keys
# Lalu isi kedua key di bawah (juga di Vercel Env saat deploy).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@maganghub.local
# Opsional: amankan endpoint cron /api/push-reminder agar tidak bisa dipicu sembarang orang.
# Jika diisi, cron harus kirim ?secret=... atau header x-cron-secret / Authorization: Bearer ...
CRON_SECRET=
