# Bisa diisi manual di sini (GEMINI_API_KEY & GITHUB_TOKEN).
# Repo GitHub sekarang disimpan di settings.json via tab "Pengaturan" (bukan di .env lagi).
# Jika lewat dashboard, file .env akan dibuat/diupdate otomatis untuk key di bawah.

GEMINI_API_KEY=
GITHUB_TOKEN=
# Model terbaru & direkomendasikan: gemini-3.6-flash (paling stabil & cepat saat ini)
# Alternatif: gemini-2.5-flash / gemini-2.0-flash jika tersedia di akunmu
GEMINI_MODEL=gemini-3.6-flash
