# Bisa diisi manual di sini, atau lewat tab "Pengaturan" di dashboard
# (kalau lewat dashboard, file .env akan dibuat/diupdate otomatis).

GEMINI_API_KEY=
REPO_PATH=
# Model terbaru & direkomendasikan: gemini-3.6-flash (paling stabil & cepat saat ini)
# Alternatif: gemini-2.5-flash / gemini-2.0-flash jika tersedia di akunmu
GEMINI_MODEL=gemini-3.6-flash
